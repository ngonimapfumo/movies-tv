<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools" >

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.MovieDB"
        tools:targetApi="31" >
        <activity
            android:name=".presentation.settings.SettingsComposeActivity"
            android:exported="false"
            android:label="@string/title_activity_settings_compose"
            android:theme="@style/Theme.MovieDB" />
        <activity
            android:name=".presentation.main.movies.HomeActivity"
            android:exported="true"
            android:screenOrientation="portrait" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".presentation.movie.PostersImagesActivity"
            android:exported="false" />
        <activity
            android:name=".presentation.auth.LoginActivity"
            android:exported="true"
            android:label="@string/title_activity_login"
            android:launchMode="singleTop"
            android:screenOrientation="locked"
            android:theme="@style/Theme.MovieDB">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data
                    android:host="auth"
                    android:pathPrefix="/callback"
                    android:scheme="moviedb" />
            </intent-filter>
        </activity>
        <activity
            android:name=".presentation.tv.episode.EpisodeActivity"
            android:exported="false"
            android:screenOrientation="locked" />
        <activity
            android:name=".presentation.reviews.ReviewsActivity"
            android:exported="false"
            android:screenOrientation="locked" />
        <activity
            android:name=".presentation.tv.season.SeasonActivity"
            android:exported="false"
            android:screenOrientation="locked" />
        <activity
            android:name=".presentation.collection.CollectionActivity"
            android:exported="false"
            android:screenOrientation="locked" />
        <activity
            android:name=".presentation.trailers.TrailerActivity"
            android:exported="false"
            android:screenOrientation="locked" />
        <activity
            android:name=".presentation.settings.SettingsActivity"
            android:exported="false"
            android:screenOrientation="locked" />
        <activity
            android:name=".presentation.watchlist.WatchlistActivity"
            android:exported="false"
            android:screenOrientation="locked" />
        <activity
            android:name=".presentation.lists.CustomListsActivity"
            android:exported="false"
            android:screenOrientation="locked" />
        <activity
            android:name=".presentation.lists.ListDetailActivity"
            android:exported="false"
            android:screenOrientation="locked" />
        <activity
            android:name=".presentation.main.tvshows.TVShowsActivity"
            android:exported="false"
            android:screenOrientation="locked" />
        <activity
            android:name=".presentation.tv.TvShowDetailActivity"
            android:exported="false"
            android:screenOrientation="locked" />
        <activity
            android:name=".presentation.person.PersonActivity"
            android:exported="false"
            android:screenOrientation="locked" />
        <activity
            android:name=".presentation.movie.MovieDetailActivity"
            android:exported="false"
            android:screenOrientation="locked" />
        <activity
            android:name=".presentation.search.SearchActivity"
            android:exported="false"
            android:screenOrientation="locked" />
        <activity
            android:name=".presentation.main.movies.MainListActivity"
            android:exported="false"
            android:screenOrientation="locked" >
        </activity>
    </application>

</manifest>